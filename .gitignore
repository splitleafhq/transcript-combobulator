# Environment variables
.env*
!.env.example
!.env.jfk-sample
!.env.ami-sample

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.coverage

# Virtual environment
.venv

# Project-specific
# Ignore everything in tmp except .gitkeep and output/example
/tmp/*
!/tmp/.gitkeep
!/tmp/output/
/tmp/output/**
!/tmp/output/.gitkeep
!/tmp/output/example/
!/tmp/output/example/**
models/*
!models/.gitkeep


# Agent-local settings (per-machine permission allowlists)
.claude/settings.local.json

# Package build output (make build)
/dist/
