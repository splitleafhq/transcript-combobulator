#!/bin/sh
# Runs what CI runs; prints one line per step and exits nonzero if any step failed.
# Needs .venv built from uv.lock: make install (uv sync --locked --extra dev)
status=0
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -x .venv/bin/python ]; then
  echo "FAIL venv: .venv is missing; run: make install (uv sync --locked --extra dev)"
  exit 1
fi
PATH="$PWD/.venv/bin:$PATH"
export PATH
run() {
  name=$1
  shift
  if out=$("$@" 2>&1); then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "$out"
    status=1
  fi
}
# The venv's tools must be the pyproject pins, or a stale pyrefly or ruff passes what CI fails.
pins=$(cat <<'PY'
import re
import sys
import tomllib
from importlib.metadata import PackageNotFoundError, version

project = tomllib.load(open("pyproject.toml", "rb"))["project"]
bad = []
for req in project["dependencies"] + project["optional-dependencies"]["dev"]:
    m = re.fullmatch(r"([A-Za-z0-9_.-]+)==([^;\s]+)", req)
    if not m:
        continue
    try:
        have = version(m[1])
    except PackageNotFoundError:
        have = "not installed"
    if have != m[2]:
        bad.append(f"{m[1]}: have {have}, pyproject pins {m[2]}")
if bad:
    print("\n".join(bad))
    print("fix with: make install")
    sys.exit(1)
PY
)
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "FAIL ffmpeg: not on PATH (brew install ffmpeg)"
  status=1
fi
run lock uv lock --check
run pins python -I -c "$pins"
run ruff-check ruff check --output-format concise .
run ruff-format ruff format --check .
run pyrefly pyrefly check
# Real whisper and VAD inference included (about 20 s). The mlx test is opt-in: make test-mlx.
run pytest python -m pytest -q --tb=short --no-header --color=no -m "not mlx"
run build uv build
exit $status
